{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework demo: Page Object Model, UI and API tests, CI, HTML reports",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "typescript": "^5.6.0"
  }
}
